rules_version = '2';
// myDoc: a person's record belongs to their own watch. Caregivers see it only after the
// person accepts them on the watch (the watch adds them to `carers`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCarer(d) { return signedIn() && request.auth.uid in d.carers; }
    function isWatch(d) { return signedIn() && d.watchUid == request.auth.uid; }
    function patient(pid) { return get(/databases/$(database)/documents/patients/$(pid)).data; }
    // A caregiver may add their own linked watches to people they already look after.
    function myWatches() {
      let u = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(u) ? get(u).data.get('watches', []) : [];
    }

    // Moving a person to a replacement watch: the new watch must have asked (a 'replace' code).
    function isReplacement() {
      let c = /databases/$(database)/documents/codes/$(request.resource.data.replaceCode);
      return exists(c) && get(c).data.role == 'replace' && get(c).data.watchUid == request.resource.data.watchUid;
    }

    // Each caregiver's own details: only they can read or change them.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /patients/{pid} {
      // Created by the patient's watch during its setup.
      allow create: if signedIn() && request.resource.data.watchUid == request.auth.uid;
      allow read: if isCarer(resource.data) || isWatch(resource.data);
      // Caregivers may update, but only the watch may add caregivers (consent).
      allow update: if isWatch(resource.data)
        || (isCarer(resource.data)
            && (request.resource.data.watchUid == resource.data.watchUid || isReplacement())
            && (!('carers' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.carers.hasOnly(resource.data.carers.concat(myWatches()))));
      allow delete: if isWatch(resource.data);

      match /{sub}/{doc} {
        allow read, write: if isCarer(patient(pid)) || isWatch(patient(pid));
      }
    }

    // Pairing codes: a watch creates one; whoever types it can ask (request) or link.
    match /codes/{code} {
      allow create: if signedIn() && request.resource.data.watchUid == request.auth.uid;
      allow get: if signedIn();
      allow update: if signedIn() && request.resource.data.watchUid == resource.data.watchUid;
      allow delete: if signedIn() && resource.data.watchUid == request.auth.uid;
    }
  }
}
