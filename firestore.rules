rules_version = '2';
// myDoc: a person's data can only be read by their caregivers and their linked watch.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCarer(d) { return signedIn() && request.auth.uid in d.carers; }
    function isWatch(d) { return signedIn() && d.watchUid == request.auth.uid; }
    function patient(pid) { return get(/databases/$(database)/documents/patients/$(pid)).data; }

    // Each caregiver's own details: only they can read or change them.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /patients/{pid} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.carers;
      allow read: if isCarer(resource.data) || isWatch(resource.data);
      allow delete: if isCarer(resource.data);
      allow update: if isCarer(resource.data)
        || (isWatch(resource.data) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['recent', 'days', 'watchInfo', 'loc', 'sos', 'ping', 'simulatedHistory', 'watchUid'])
            && (request.resource.data.watchUid == request.auth.uid || request.resource.data.watchUid == null));

      match /{sub}/{doc} {
        allow read, write: if isCarer(patient(pid)) || isWatch(patient(pid));
      }
    }

    // Pairing codes: the watch creates one; a caregiver who types it links it.
    match /codes/{code} {
      allow create: if signedIn() && request.resource.data.watchUid == request.auth.uid;
      allow get: if signedIn();
      allow update: if signedIn() && request.resource.data.watchUid == resource.data.watchUid;
      allow delete: if signedIn() && resource.data.watchUid == request.auth.uid;
    }
  }
}
